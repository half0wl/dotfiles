# Defaults
font-family = "Monaspace Krypton NF"
font-size = 12
background = #10161A
window-padding-x = 15
window-padding-y = 10

# Keybinds
keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard:plain
keybind = ctrl+insert=copy_to_clipboard:plain
