      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git config -l:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git check-ignore:*)",
      "Bash(git stash list:*)",
      "Bash(git reflog:*)",
      "Bash(git cat-file:*)",
      "Bash(git name-rev:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git for-each-ref:*)",
      "Bash(npx tsx:*)",
      "Bash(npx tsc:*)",
      "Bash(npx biome:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm tsx:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm jest:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm graphql-codegen:*)",
      "Bash(pnpm prisma generate:*)",
      "Bash(pnpm prisma migrate dev:*)",
      "Bash(pnpm prisma migrate deploy:*)",
      "Bash(go mod tidy:*)",
      "Bash(go build:*)",
      "Bash(wails dev:*)",
      "Bash(wails build:*)",
      "Bash(pm2 list:*)",
      "Bash(pm2 logs:*)",
      "Bash(pm2 stop:*)",
      "Bash(ping:*)",
      "Bash(traceroute:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(host:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(netstat:*)",
      "Bash(ss:*)",
      "Bash(ifconfig:*)",
      "Bash(ip addr:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(md5:*)",
      "Bash(shasum:*)",
      "Bash(xxd:*)",
      "Bash(hexdump:*)",
      "Bash(node --version:*)",
      "Bash(python --version:*)",
      "Bash(python3 --version:*)",
      "Bash(npm list:*)",
      "Bash(pnpm list:*)",
      "Bash(cargo check:*)",
      "Bash(go list:*)",
      "Bash(rustc --version:*)",
      "Bash(go version:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(tree:*)",
      "Bash(date:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr list --head \"$(git branch --show-current)\":*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "WebSearch",
      "WebFetch",
      "Read(~/.claude/plans/*)",
      "Skill(rc-*)",
      "Skill(check-impl)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_type"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/**)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.railway/**)",
      "Read(~/.raildev/**)",
      "Read(~/.codex/**)",
      "Read(~/Library/**)",
      "Read(~/Desktop/**)",
      "Read(~/Downloads/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.claude.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/dotfiles/.git/**)",
      "Edit(~/dotfiles/.git/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/rc/Workspace",
      "/Users/rc/.claude/plans",
      "/Users/rc/.claude/projects",
      "/private/tmp/claude-501",
      "/Users/rc/dotfiles",
      "/Users/rc/Documents/Yggdrasil"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh /Users/rc/dotfiles/conf/claude/hooks/documents-fence.zsh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh /Users/rc/dotfiles/conf/claude/hooks/dotfiles-git-fence.zsh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": false,
    "feature-dev@claude-code-plugins": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.tiptap.dev"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm",
        "~/Library/Caches/pnpm",
        "~/Documents/Yggdrasil"
      ],
      "denyWrite": [
        "~/dotfiles/.git"
      ],
      "denyRead": [
        "~/",
        "/Users",
        "/Volumes",
        "~/dotfiles/.git"
      ],
      "allowRead": [
        "~/Workspace",
        "~/.gitconfig",
        "~/dotfiles/conf/.gitconfig",
        "~/.gitignore_global",
        "~/dotfiles/conf/.gitignore_global",
        "~/.config/git/hooks",
        "~/dotfiles/conf/git/hooks",
        "~/.claude/plans",
        "~/.claude/projects",
        "~/.claude/shell-snapshots",
        "~/.claude/skills",
        "~/dotfiles/conf/claude/skills",
        "~/Library/pnpm",
        "~/go",
        "~/dotfiles",
        "~/.npmrc",
        "~/Library/Preferences/pnpm",
        "~/Library/Caches/pnpm",
        "~/Documents/Yggdrasil"
      ]
    },
    "excludedCommands": [
      "raildev *",
      "railway *",
      "docker *",
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "codex *",
      "/Users/rc/dotfiles/bin/codex-run *",
      "ps *",
      "top *",
      "pgrep *"
    ]
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "ultracode": true,
  "fastMode": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(raildev run_cmd:*)",
      "Bash(railway logs:*)",
      "Bash(pnpm turbo run typecheck:*)",
      "Bash(pnpm turbo run lint:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(railway link:*)",
      "Bash(psql:*) when targeting prod database connection strings"
    ]
  }
}
